<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- comment -%}
  Explicit allowlist rather than a scan of site.pages. Scanning pulls in the
  Search Console verification file, the rendered assets/README.html and other
  build artifacts, which pollutes the sitemap with URLs that should not rank.
  Add a line here when a new documentation page is created.

  changefreq and priority are intentionally omitted: Google ignores both.
{%- endcomment -%}
{%- assign paths = "/,/CLEANROOM.html,/docs/ARCHITECTURE.html,/docs/PARITY.html,/docs/PERF.html,/docs/PLAN.html" | split: "," -%}
{%- for path in paths %}
  <url>
    <loc>{{ path | absolute_url }}</loc>
  </url>
{%- endfor %}
</urlset>
